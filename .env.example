# Required: CDV instance URL and API key (always needed)
CDV_BASE_URL=https://your-cdv-instance.cloudera.site/
CDV_API_KEY=your_cdv_api_key_here

# Optional: CDV username and password for session authentication.
#
# These enable chart and dashboard creation tools:
#   create_smart_visual, create_dashboard, create_visual,
#   update_visual, delete_visual
#
# When omitted, those tools are NOT registered in the MCP server.
# The server will still expose data exploration tools:
#   query_dataapi, list_connections, list_datasets, list_visuals,
#   get_visual, list_workspaces, and all admin tools (groups, users, etc.)
#
# CDV uses a session-authenticated endpoint to persist chart shelf configurations
# (column assignments).  Without this, visuals would be created but render blank.
CDV_USERNAME=vizapps_admin
CDV_PASSWORD=vizapps_admin
